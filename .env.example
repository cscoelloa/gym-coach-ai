# Copiar a `.env` y rellenar. `.env` NUNCA se sube al repositorio.
# Cómo generar cada clave: .docs/05-runbook.md

# --- Django ---
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambiame
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Cifrado de las API keys en base de datos (MultiFernet) ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Lista separada por comas. La PRIMERA cifra; todas descifran. El orden importa al rotar.
FIELD_ENCRYPTION_KEYS=cambiame

# --- Base de datos ---
# Puertos altos: el compose los expone ahi para no chocar con instalaciones nativas que ya ocupen
# los puertos habituales (5432-5434 y 6379 en esta maquina).
DATABASE_URL=postgres://gym:gym@localhost:55432/gym

# --- Redis / Celery ---
REDIS_URL=redis://127.0.0.1:6380/0

# Solo en desarrollo: las tareas se ejecutan dentro del proceso, sin worker ni Redis. Ponlo a
# False para probar Celery de verdad. En producción no se lee (`prod.py` no lo mira).
# CELERY_TASK_ALWAYS_EAGER=True

# --- Correo (solo producción; en desarrollo se imprime en consola) ---
DEFAULT_FROM_EMAIL=noreply@project-gym.local

# El origen con el que se construyen los enlaces de los correos. Lo lee `config/settings/base.py`
# y **tiene un valor por defecto**, que es justo lo peligroso: si se olvida en producción, el
# correo de «análisis listo» y el de reseteo de contraseña salen enlazando a
# http://localhost:8000 — se envían, nadie ve un error, y el enlace no lleva a ninguna parte.
# Hace falta porque una tarea de Celery no tiene `request` del que sacar el dominio.
SITE_URL=http://localhost:8000
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- Frontend en React (ADR-047) ---
# Con valor, las pantallas migradas cargan los módulos del servidor de Vite y hay recarga en
# caliente; hay que tenerlo arrancado (`npm --prefix frontend run dev`). Vacío o sin definir,
# se sirve el bundle de `frontend/dist`, que hay que haber construido.
#
# Es una variable propia y no `DEBUG` a propósito: los fallos de orden de carga, de rutas con
# hash y de `base` solo aparecen contra el bundle construido, y hay que poder verlos con
# DEBUG=True.
# VITE_DEV_SERVER_URL=http://localhost:5173

# --- PWA (ADR-063) ---
# La aplicación instalada abre sin red: el service worker guarda la cáscara y el build, nunca los
# datos. `False` es el interruptor de emergencia: `/sw.js` pasa a ser uno que no cachea, borra lo
# guardado y se activa en el acto. Solo para cuando un despliegue deje a alguien atascado en una
# versión vieja. Con VITE_DEV_SERVER_URL puesto no cachea de todas formas.
# PWA_OFFLINE=True

# --- Avisos push (ADR-066) ---
# «Se acabó el descanso» con la aplicación cerrada. Las tres o ninguna: sin ellas el aviso está
# apagado y la aplicación no lo ofrece. Cómo generarlas: .docs/05-runbook.md («El descanso y los
# avisos push»). Para probarlo en local hace falta un worker de Celery y
# CELERY_TASK_ALWAYS_EAGER=False.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:alguien@ejemplo.com

# --- Producción ---
# En producción, además de lo de arriba: DEBUG=False, ALLOWED_HOSTS con el dominio real y
# SITE_URL=https://midominio.com (el valor por defecto apunta a localhost).
#
# DJANGO_SETTINGS_MODULE=config.settings.prod
#   `manage.py` cae en `config.settings.dev` si no está. El proceso web no lo necesita
#   —`scripts/start-web.sh` lo fija por su cuenta— y el `Procfile` lo pasa explícito a `worker` y
#   `beat`, pero cualquier comando lanzado a mano en el contenedor (`shell`, `import_catalog`,
#   `createsuperuser`) sí lo necesita, o correrá con los settings de desarrollo.
#
# PORT y WEB_CONCURRENCY las pone la plataforma; `scripts/start-web.sh` usa 8000 y 2 si faltan.
#
# CSRF_TRUSTED_ORIGINS=https://midominio.com

# --- media/ en Cloudflare R2 (solo producción — en desarrollo es disco local) ---
# Token de API con permiso de lectura/escritura sobre el bucket, creado en el dashboard de
# Cloudflare → R2 → Manage API Tokens. R2_ENDPOINT_URL lleva el id de cuenta:
# https://<account_id>.r2.cloudflarestorage.com
# R2_PUBLIC_DOMAIN es el subdominio r2.dev del bucket (o un dominio propio conectado) — sin
# habilitar el acceso público del bucket en Cloudflare, las imágenes no cargan aunque el resto
# esté bien configurado.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=
# R2_PUBLIC_DOMAIN=

# Las API keys de los proveedores de IA NO van aquí: se configuran desde /admin/ y se guardan
# cifradas en la base de datos. Ver .docs/03-ai-config.md
