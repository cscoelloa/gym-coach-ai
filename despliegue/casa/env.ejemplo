# Plantilla del `.env` del alojamiento en casa (ADR-070).
#
# No hace falta copiarla a mano: `sh scripts/casa.sh preparar <tu-pc>.<tailnet>.ts.net` crea
# `despliegue/casa/.env` con los secretos ya generados. Aquí está para saber qué es cada cosa.
#
# El `.env` real NO se comitea (lo ignora `.gitignore`) y SÍ se guarda una copia fuera del PC:
# sin `FIELD_ENCRYPTION_KEYS`, las claves de IA que haya en un respaldo no se pueden descifrar.

# --- La dirección por la que entras ------------------------------------------------------------
# El nombre del PC en tu tailnet, tal como sale en la consola de Tailscale (Machines).
ALLOWED_HOSTS=gym.tu-tailnet.ts.net
# La misma, con https://. Django rechaza un POST cuyo `Origin` no esté aquí.
CSRF_TRUSTED_ORIGINS=https://gym.tu-tailnet.ts.net
# Con lo que se construyen los enlaces de los correos y de los avisos.
SITE_URL=https://gym.tu-tailnet.ts.net

# --- Secretos ----------------------------------------------------------------------------------
# Firma las sesiones y los tokens de CSRF. Cambiarla cierra todas las sesiones.
SECRET_KEY=
# Clave Fernet con que se cifran en la base de datos las API keys de los proveedores de IA.
# Admite varias separadas por comas (la primera cifra, todas descifran) para rotarla.
FIELD_ENCRYPTION_KEYS=
# La contraseña de Postgres. Solo letras y números: va dentro de una URL (`DATABASE_URL`).
POSTGRES_PASSWORD=

# --- Avisos push al acabar el descanso (ADR-066) -----------------------------------------------
# Las tres o ninguna. Sin ellas la aplicación no ofrece el aviso, y todo lo demás funciona.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# `mailto:` con un correo tuyo de verdad: Apple rechaza direcciones de juguete.
VAPID_SUBJECT=

# --- Opcional ----------------------------------------------------------------------------------
# El puerto de 127.0.0.1 en el que escucha Caddy, y al que apunta `tailscale serve`.
# PUERTO_LOCAL=8080
# Correo saliente (recuperar contraseña). Sin él, los correos se quedan en `casa.sh logs web`.
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
